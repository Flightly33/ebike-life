Bikes.List = list
Bikes.ById = {} :: { [string]: Bike }
for index, bike in list do
	Bikes.ById[bike.Id] = bike
	local _ = index
end

function Bikes.Get(id: string): Bike?
	return Bikes.ById[id]
end

function Bikes.FullName(bike: Bike): string
	return "Flightly " .. bike.Name
end

-- Order in the shop
function Bikes.Index(id: string): number
	for i, bike in list do
		if bike.Id == id then
			return i
		end
	end
	return 0
end

-- "500 W", "1.5 kW"
function Bikes.FormatWatts(w: number): string
	if w >= 1000 then
		local kw = w / 1000
		if kw == math.floor(kw) then
			return string.format("%d kW", kw)
		end
		return string.format("%.1f kW", kw)
	end
	return string.format("%d W", w)
end

function Bikes.FormatWh(wh: number): string
	if wh >= 1000 then
		return string.format("%.1f kWh", wh / 1000)
	end
	return string.format("%d Wh", wh)
end

return Bikes

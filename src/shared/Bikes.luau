--[[
	Bikes: the Flightly line-up, sold at Flighty Mechanics.

	All light electric motorbikes ("e-motos", like the Sur-Ron class): throttle, no pedals, a
	mid-mounted motor driving the rear wheel by chain, real peak power and pack sizes at real voltages
	and real weights, from a 2 kW youth pit bike to 25 kW (the top of the class), plus the Deathrider.
	They're off-road machines; the cops take an interest when they're ridden over 45 km/h on the street.

	Physics reads these through BikeStats.Compute, which also applies the player's tuning upgrades.
]]

local Bikes = {}

export type Style = "City" | "Folding" | "Cruiser" | "Cargo" | "Fat" | "Hardtail" | "Road" | "Enduro" | "Moped" | "Moto"
-- E-moto body kits: a youth pit bike, a dirt bike (high fender, number plate), a supermoto (low
-- fender, number boards), an enduro (headlight, hand guards), a street bike (round / LED headlight,
-- mirrors, tail tidy) and a chopper (the Deathrider)
export type Kit = "Pit" | "Dirt" | "Supermoto" | "Enduro" | "Street" | "Chopper"
export type Rarity = "Common" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Cursed"

export type Geometry = {
	Style: Style,
	WheelDiameter: number, -- outer tyre diameter, m
	RearWheelDiameter: number?, -- mullet bikes
	TireWidth: number, -- m
	Wheelbase: number, -- m
	SeatHeight: number, -- saddle top above ground, m
	BarHeight: number, -- grips above ground, m
	BarWidth: number, -- m
	Kit: Kit?, -- e-moto body kit (fenders, lights, plates, tail)
}

export type Bike = {
	Id: string,
	Name: string, -- model name; shown as "Flightly <Name>"
	Type: string,
	Blurb: string,
	Price: number,
	Level: number, -- unlocks at this player level
	Rarity: Rarity,
	Class: string, -- "Class 1", "Class 2", "Class 3", "Off-road"
	LegalKmh: number, -- street-legal assist limit
	MaxKmh: number, -- controller limit with the limiter unlocked (off-road mode)
	Drive: string, -- "Rear hub", "Mid-drive", ...
	NominalW: number,
	PeakW: number,
	TorqueNm: number, -- motor torque as the maker quotes it
	WheelTorqueNm: number, -- torque at the rear wheel (after gearing), drives the physics
	Volts: number,
	BatteryWh: number,
	WeightKg: number,
	Throttle: boolean,
	Pedals: boolean,
	Brakes: string,
	BrakeG: number, -- deceleration the brakes manage on dry tarmac, in g
	Suspension: string,
	Tires: string,
	TireKind: "Road" | "Hybrid" | "Knobby" | "Fat" | "Moto",
	CdA: number, -- drag area, m²
	Crr: number, -- rolling resistance on tarmac
	Regen: number, -- fraction of braking energy a hub motor puts back
	HopSpeed: number, -- m/s a bunny hop launches at
	Landing: number, -- rad of pitch error a landing tolerates
	AirControl: number,
	WheeliePop: number, -- 0..1+: how readily the front comes up
	Geometry: Geometry,
	Colors: { Frame: Color3, Accent: Color3, Rims: Color3 },
	Effects: string?, -- "Hellfire": flaming exhaust and wheels, and the rider's skull burns
}

Bikes.RarityColors = {
	Common = Color3.fromRGB(205, 205, 205),
	Rare = Color3.fromRGB(70, 150, 255),
